{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "outDir": "dist",
    "rootDir": ".",
    "declaration": true
  },
  "include": ["sim/**/*.ts", "mcts/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
