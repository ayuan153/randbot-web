  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.5",
    "@types/chrome": "^0.0.287",
    "typescript": "^5.8.0",
    "vite": "^6.0.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=20"
  }
}
