{
  "name": "randbats-bot",
  "version": "0.1.0",
  "description": "EV-based move suggestion overlay for Pokémon Showdown Random Battles",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build && node scripts/post-build.mjs",
